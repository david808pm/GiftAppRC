// ── Support Requests ─────────────────────────────────────

enum SupportType {
  NOT_FOUND
  BENEFICIARY_DATA_INCORRECT
  MISSING_BENEFICIARY
  AGE_GENDER_INCORRECT
  GIFT_SELECTION_PROBLEM
  OTHER
}

enum SupportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  REJECTED
}

model SupportRequest {
  id                Int                    @id @default(autoincrement())
  campaignId        Int?
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])
  employeeId        Int?
  employee          Employee?              @relation(fields: [employeeId], references: [id])
  documentId        String?                @db.VarChar(50)
  type              SupportType
  message           String                 @db.Text
  status            SupportStatus          @default(OPEN)
  internalNote      String?                @db.Text
  verifiedEmployee  Boolean                @default(false)
  resolvedAt        DateTime?
  resolvedById      Int?
  resolvedBy        AdminUser?             @relation("SupportRequestsResolved", fields: [resolvedById], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  history           SupportRequestHistory[]

  @@index([campaignId])
  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@index([documentId])
  @@index([createdAt])

  emails EmailLog[]
}

model SupportRequestHistory {
  id                   Int            @id @default(autoincrement())
  supportRequestId     Int
  supportRequest       SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  previousStatus       SupportStatus?
  newStatus            SupportStatus
  previousInternalNote String?        @db.Text
  newInternalNote      String?        @db.Text
  changedById          Int?
  changedBy            AdminUser?     @relation("SupportRequestHistoryChanges", fields: [changedById], references: [id])
  changedAt            DateTime       @default(now())

  @@index([supportRequestId])
}

// ── Selections ───────────────────────────────────────────

enum SelectionStatus {
  CONFIRMED
  CANCELLED
}

model Selection {
  id                         Int              @id @default(autoincrement())
  campaignId                 Int
  campaign                   Campaign         @relation(fields: [campaignId], references: [id])
  employeeId                 Int
  employee                   Employee         @relation(fields: [employeeId], references: [id])
  status                     SelectionStatus  @default(CONFIRMED)
  confirmedAt                DateTime         @default(now())
  cancelledAt                DateTime?
  cancelledById              Int?
  cancelledBy                AdminUser?       @relation("SelectionsCancelled", fields: [cancelledById], references: [id])
  cancellationReason         String?          @db.VarChar(500)
  employeeNameSnapshot       String           @db.VarChar(180)
  employeeDocumentIdSnapshot String           @db.VarChar(50)
  campaignNameSnapshot       String           @db.VarChar(180)
  createdAt                  DateTime         @default(now())
  items                      SelectionItem[]
  emailLogs                  EmailLog[]

  @@unique([campaignId, employeeId])
  @@index([campaignId])
  @@index([employeeId])
  @@index([status])
  @@index([confirmedAt])
}

model SelectionItem {
  id                       Int       @id @default(autoincrement())
  selectionId              Int
  selection                Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  campaignId               Int
  campaign                 Campaign  @relation(fields: [campaignId], references: [id])
  employeeId               Int
  employee                 Employee  @relation(fields: [employeeId], references: [id])
  beneficiaryId            Int
  beneficiary              Beneficiary @relation(fields: [beneficiaryId], references: [id])
  giftId                   Int
  gift                     Gift      @relation(fields: [giftId], references: [id])
  beneficiaryNameSnapshot  String    @db.VarChar(180)
  beneficiaryAgeSnapshot   Int
  beneficiaryGenderSnapshot String   @db.VarChar(10)
  giftNameSnapshot         String    @db.VarChar(180)
  giftReferenceSnapshot    String    @db.VarChar(50)
  giftImageUrlSnapshot     String?   @db.VarChar(500)
  confirmedAt              DateTime  @default(now())
  stockMovements           StockMovement[]

  @@unique([selectionId, beneficiaryId])
  @@index([selectionId])
  @@index([campaignId])
  @@index([employeeId])
  @@index([beneficiaryId])
  @@index([giftId])
}

// ── Stock Movements ──────────────────────────────────────

enum StockMovementType {
  SELECTION_CONFIRMATION
  ADMIN_ADJUSTMENT
  RESTOCK
  CORRECTION
}

model StockMovement {
  id              Int                @id @default(autoincrement())
  giftId          Int
  gift            Gift               @relation(fields: [giftId], references: [id])
  campaignId      Int
  campaign        Campaign           @relation(fields: [campaignId], references: [id])
  selectionItemId Int?
  selectionItem   SelectionItem?     @relation(fields: [selectionItemId], references: [id])
  movementType    StockMovementType
  quantityChange  Int
  previousStock   Int
  newStock        Int
  reason          String?            @db.VarChar(500)
  createdById     Int?
  createdBy       AdminUser?         @relation("StockMovementsCreated", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([giftId])
  @@index([campaignId])
  @@index([selectionItemId])
  @@index([movementType])
  @@index([createdAt])
}

// ── Email Logs ───────────────────────────────────────────

enum EmailType {
  CONFIRMATION
  SUPPORT_NOTIFICATION
  ADMIN_NOTIFICATION
  OTHER
}

enum EmailStatus {
  SIMULATED
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id                 Int          @id @default(autoincrement())
  campaignId         Int?
  campaign           Campaign?    @relation(fields: [campaignId], references: [id])
  employeeId         Int?
  employee           Employee?    @relation(fields: [employeeId], references: [id])
  selectionId        Int?
  selection          Selection?   @relation(fields: [selectionId], references: [id])
  supportRequestId   Int?
  supportRequest     SupportRequest? @relation(fields: [supportRequestId], references: [id])
  recipientEmail     String?      @db.VarChar(180)
  emailType          EmailType
  status             EmailStatus  @default(SIMULATED)
  subject            String?      @db.VarChar(255)
  details            String?      @db.Text
  providerMessageId  String?      @db.VarChar(255)
  sentAt             DateTime?
  createdAt          DateTime     @default(now())

  @@index([campaignId])
  @@index([employeeId])
  @@index([selectionId])
  @@index([supportRequestId])
  @@index([emailType])
  @@index([status])
}
