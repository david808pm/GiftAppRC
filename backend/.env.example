# Database — PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Database — Local MySQL (legacy, for rollback reference)
# DATABASE_URL="mysql://root:password@localhost:3306/giftapp_db"
# DIRECT_URL="mysql://root:password@localhost:3306/giftapp_db"

# JWT — must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="8h"

# Public Employee JWT — MUST be different from JWT_SECRET, also min 32 chars.
PUBLIC_JWT_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_SECRET_MIN_32_CHARS"
PUBLIC_JWT_EXPIRES_IN="4h"

# App
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
ENABLE_TIMING_LOGS=false

# Admin Seed — set a strong password; the seed will not print it.
ADMIN_SEED_EMAIL="admin@giftapp.com"
ADMIN_SEED_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Supabase Storage — gift images (bucket: gift-images)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="gift-images"

# ── Public Employee Login — Email OTP ───────────────────────
# Feature flag: when false the classic documentId-only login is used
# and the frontend renders the old login form. Set to true to enable
# the email OTP flow (request-code → verify-code).
PUBLIC_LOGIN_OTP_ENABLED=false
# OTP lifetime in minutes.
PUBLIC_LOGIN_OTP_EXPIRY_MINUTES=10
# Max failed verify attempts before locking.
PUBLIC_LOGIN_OTP_MAX_ATTEMPTS=5
# Lock duration in minutes after too many failed attempts.
PUBLIC_LOGIN_OTP_LOCK_MINUTES=10
# Resend cooldown in seconds between code requests.
PUBLIC_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
# Resend (https://resend.com) API key — backend only.
# NEVER expose this to the frontend (do NOT create VITE_RESEND_API_KEY).
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_API_KEY"
# From address used for OTP emails.
EMAIL_FROM="no-reply@yourdomain.com"

# ── Health / Version metadata ───────────────────────────────
# Optional overrides for the /api/health/version endpoint.
# Safe to expose — these are not secrets.
# APP_COMMIT=
# GIT_COMMIT=
# BUILD_DATE=
