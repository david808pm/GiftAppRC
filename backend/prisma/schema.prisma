generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Companies ─────────────────────────────────────────────

model Company {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(180)
  slug        String     @unique @db.VarChar(200)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  campaigns   Campaign[]
  adminUsers  AdminUser[]

  @@index([slug])
  @@index([isActive])
}

// ── Auth & Users ──────────────────────────────────────────

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  description String?      @db.VarChar(255)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  adminUsers  AdminUser[]
}

model AdminUser {
  id               Int        @id @default(autoincrement())
  name             String     @db.VarChar(120)
  email            String     @unique @db.VarChar(180)
  password         String     @db.VarChar(255)
  roleId           Int
  role             Role       @relation(fields: [roleId], references: [id])
  companyId        Int?
  company          Company?   @relation(fields: [companyId], references: [id])
  isActive         Boolean    @default(true)
  campaignsCreated Campaign[] @relation("CampaignsCreated")
  campaignsUpdated Campaign[] @relation("CampaignsUpdated")
  employeesCreated  Employee[] @relation("EmployeesCreated")
  employeesUpdated  Employee[] @relation("EmployeesUpdated")
  beneficiariesCreated Beneficiary[] @relation("BeneficiariesCreated")
  beneficiariesUpdated Beneficiary[] @relation("BeneficiariesUpdated")
  giftsCreated         Gift[]        @relation("GiftsCreated")
  giftsUpdated         Gift[]        @relation("GiftsUpdated")
  supportResolved      SupportRequest[] @relation("SupportRequestsResolved")
  historyChanges       SupportRequestHistory[] @relation("SupportRequestHistoryChanges")
  selectionsCancelled  Selection[] @relation("SelectionsCancelled")
  stockMovementsCreated StockMovement[] @relation("StockMovementsCreated")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([email])
  @@index([roleId])
  @@index([companyId])
}

// ── Campaigns ────────────────────────────────────────────

enum CampaignStatus {
  ACTIVE
  CLOSED
  DRAFT
  PAUSED
  ARCHIVED
}

model Campaign {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(180)
  slug          String          @unique @db.VarChar(200)
  welcomeText   String?         @db.Text
  rulesText     String?         @db.Text
  status        CampaignStatus  @default(ACTIVE)
  logoText      String?         @db.VarChar(80)
  primaryColor  String?         @db.VarChar(7)
  logoImageUrl  String?         @db.VarChar(500)
  companyId     Int?
  company       Company?        @relation(fields: [companyId], references: [id])
  startsAt      DateTime?
  endsAt        DateTime?
  createdById   Int?
  createdBy     AdminUser?      @relation("CampaignsCreated", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     AdminUser?      @relation("CampaignsUpdated", fields: [updatedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  employees     Employee[]
  gifts         Gift[]
  supportRequests SupportRequest[]
  selections     Selection[]
  stockMovements StockMovement[]
  emailLogs      EmailLog[]
  selectionItems SelectionItem[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([companyId])
}

// ── Employees ────────────────────────────────────────────

enum EmployeeStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  BLOCKED
}

model Employee {
  id          Int            @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign       @relation(fields: [campaignId], references: [id])
  fullName    String         @db.VarChar(180)
  documentId  String         @db.VarChar(50)
  email           String?        @db.VarChar(180)
  phone           String?        @db.VarChar(30)
  shippingAddress String?        @db.VarChar(255)
  shippingCity    String?        @db.VarChar(100)
  status          EmployeeStatus @default(PENDING)
  confirmedAt DateTime?
  createdById Int?
  createdBy   AdminUser?     @relation("EmployeesCreated", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   AdminUser?     @relation("EmployeesUpdated", fields: [updatedById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@unique([campaignId, documentId])
  @@index([campaignId])
  @@index([status])
  @@index([documentId])
  @@index([deletedAt])

  beneficiaries Beneficiary[]
  supportRequests SupportRequest[]
  selections       Selection[]
  selectionItems   SelectionItem[]
  emailLogs        EmailLog[]
}

// ── Beneficiaries ────────────────────────────────────────

enum Gender {
  male
  female
}

model Beneficiary {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  fullName    String    @db.VarChar(180)
  age         Int       @default(0)
  gender      Gender    @default(male)
  createdById Int?
  createdBy   AdminUser? @relation("BeneficiariesCreated", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   AdminUser? @relation("BeneficiariesUpdated", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([employeeId])
  @@index([gender])
  @@index([deletedAt])

  selectionItems SelectionItem[]
}

// ── Gifts ────────────────────────────────────────────────

enum GiftAllowedGender {
  all
  male
  female
}

enum GiftStatus {
  ACTIVE
  INACTIVE
}

model Gift {
  id                   Int               @id @default(autoincrement())
  campaignId           Int
  campaign             Campaign          @relation(fields: [campaignId], references: [id])
  name                 String            @db.VarChar(180)
  reference            String            @db.VarChar(50)
  shortDescription     String?           @db.Text
  technicalDescription String?           @db.Text
  dimensions           String?           @db.VarChar(100)
  stock                Int               @default(0)
  minAge               Int               @default(0)
  maxAge               Int               @default(13)
  allowedGender        GiftAllowedGender @default(all)
  status               GiftStatus        @default(ACTIVE)
  createdById          Int?
  createdBy            AdminUser?        @relation("GiftsCreated", fields: [createdById], references: [id])
  updatedById          Int?
  updatedBy            AdminUser?        @relation("GiftsUpdated", fields: [updatedById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  images               GiftImage[]
  selectionItems       SelectionItem[]
  stockMovements       StockMovement[]

  @@unique([campaignId, reference])
  @@index([campaignId])
  @@index([status])
  @@index([allowedGender])
  @@index([deletedAt])
}

model GiftImage {
  id         Int      @id @default(autoincrement())
  giftId     Int
  gift       Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  imageUrl   String   @db.VarChar(500)
  altText    String?  @db.VarChar(180)
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([giftId])
  @@index([sortOrder])
}

